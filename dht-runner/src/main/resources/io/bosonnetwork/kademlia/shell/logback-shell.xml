<?xml version="1.0" encoding="UTF-8" ?>
<!--
  The DHT shell's fallback logging configuration, used when no other one is named or the one named
  does not exist. It logs to a file only: anything written to the console lands on the prompt.
  LOG_DIR is set by dht-shell.sh, and defaults to ~/.cache/boson/shell/logs.
-->
<configuration>
  <appender name="ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/shell.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/shell-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>100MB</maxFileSize>
      <maxHistory>7</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{32} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="io.netty" level="OFF"/>
  <logger name="io.vertx" level="OFF"/>

  <root level="INFO">
    <appender-ref ref="ROLLING" />
  </root>
</configuration>
