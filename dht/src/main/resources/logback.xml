<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Sample logging configuration for a Boson node.

  Levels, and what each one is for here:

    INFO   the node's own lifecycle - started, stopped, bootstrapping, maintenance.
    WARN   something is wrong with THIS node and someone should look.
    ERROR  something is wrong with this node and it is not working.
    DEBUG  what the node rejected and why - throttled, undecryptable, unparseable, a token that
           did not verify, a message from an address we will not route to.

  That last line is the one to know about. A public node is sent malformed, spoofed and stale
  packets continuously; none of it is a warning about the node, so none of it is logged above
  DEBUG. Turn it on when diagnosing, and expect volume proportional to whatever is being sent at
  the node rather than to anything the node is doing:

    <logger name="io.bosonnetwork.kademlia.rpc" level="DEBUG"/>
    <logger name="io.bosonnetwork.kademlia.impl" level="DEBUG"/>

  How much of it there was is also counted, unconditionally and far more cheaply, by the metrics
  (see DHTMetrics.Reason) - prefer those for "how many", and the log for "which peer".
-->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{32} - %msg %ex{full}%n</pattern>
    </encoder>
  </appender>

  <appender name="ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${BOSON_LOG:-boson.log}</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <!-- rollover daily -->
      <fileNamePattern>boson-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
       <!-- each file should be at most 100MB, keep 60 days worth of history, but at most 20GB -->
       <maxFileSize>100MB</maxFileSize>
       <maxHistory>60</maxHistory>
       <totalSizeCap>8GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{32} - %msg %ex{full}%n</pattern>
    </encoder>
  </appender>

  <logger name="io.netty" level="OFF"/>
  <logger name="io.vertx" level="OFF"/>

  <root level="INFO">
    <appender-ref ref="STDOUT" />
    <appender-ref ref="ROLLING" />
  </root>
</configuration>
